generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DELETED
  BLOCKED
}

enum ContentPolicy {
  ALLOWED
  BLOCKED
  REVIEW
}

enum OrderStatus {
  CREATED
  AWAITING_PAYMENT
  PAID
  QUEUED
  PROCESSING
  GENERATION_COMPLETED
  DELIVERY_PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum GenerationStatus {
  CREATED
  SUBMITTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  IGNORED
  FAILED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum JobPriority {
  HIGH
  NORMAL
  LOW
}

model User {
  id                 String    @id @default(cuid())
  whatsappPhone      String    @unique
  name               String?
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastInteractionAt  DateTime?

  orders   Order[]
  messages Message[]
}

model Product {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String
  priceCents    Int
  currency      String        @default("BRL")
  prompt        String
  active        Boolean       @default(true)
  sortOrder     Int           @default(0)
  provider      String
  model         String
  contentPolicy ContentPolicy @default(ALLOWED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  orders Order[]

  @@index([active, sortOrder])
  @@index([provider])
}

model Order {
  id                    String      @id @default(cuid())
  userId                String
  productId             String
  status                OrderStatus @default(CREATED)
  amountCents           Int
  currency              String      @default("BRL")
  inputImageKey         String?
  outputImageKey        String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  paidAt                DateTime?
  processingStartedAt   DateTime?
  completedAt           DateTime?
  failedAt              DateTime?
  cancelledAt           DateTime?
  failureCode           String?
  failureMessage        String?

  user         User         @relation(fields: [userId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  payments     Payment[]
  generations  Generation[]
  deliveries   Delivery[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([productId])
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  provider           String
  externalPaymentId  String
  status             PaymentStatus @default(CREATED)
  amountCents        Int
  currency           String        @default("BRL")
  rawStatus          String?
  pixCopyPaste       String?
  pixQrCodeBase64    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  paidAt             DateTime?
  expiresAt          DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@unique([provider, externalPaymentId])
  @@index([orderId])
  @@index([status])
}

model Generation {
  id             String           @id @default(cuid())
  orderId        String
  provider       String
  model          String
  externalId     String?
  status         GenerationStatus @default(CREATED)
  prompt         String
  inputUrl       String?
  outputUrl      String?
  estimatedCost  Decimal?         @db.Decimal(12, 6)
  durationMs     Int?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime         @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@unique([provider, externalId])
  @@index([orderId])
  @@index([status])
}

model Delivery {
  id                 String         @id @default(cuid())
  orderId            String
  channel            String         @default("whatsapp")
  status             DeliveryStatus @default(PENDING)
  attempts           Int            @default(0)
  externalMessageId  String?
  lastError          String?
  createdAt          DateTime       @default(now())
  sentAt             DateTime?
  updatedAt          DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, status])
}

model WebhookEvent {
  id               String             @id @default(cuid())
  provider         String
  externalEventId  String
  eventType        String
  payloadHash      String
  payload          Json
  status           WebhookEventStatus @default(RECEIVED)
  receivedAt       DateTime           @default(now())
  processedAt      DateTime?

  @@unique([provider, externalEventId])
  @@index([provider, eventType])
  @@index([status])
}

model Message {
  id                 String           @id @default(cuid())
  userId             String
  externalMessageId  String?          @unique
  direction          MessageDirection
  type               String
  content            String?
  mediaId            String?
  createdAt          DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model ConversationAudit {
  id        String   @id @default(cuid())
  userId    String
  state     String
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum AdminRole {
  ADMIN
  VIEWER
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

enum AuditAction {
  ADMIN_LOGIN
  ADMIN_LOGOUT
  ADMIN_CREATED
  ADMIN_UPDATED
  ADMIN_SUSPENDED
  PRODUCT_UPDATED
  PRODUCT_TOGGLED
  ORDER_VIEWED
  GENERATION_VIEWED
}

model AdminUser {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String?
  role         AdminRole   @default(VIEWER)
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  createdBy    String?
  auditLogs    AuditLog[]

  @@index([email])
  @@index([status])
}

model AuditLog {
  id          String      @id @default(cuid())
  adminId     String
  action      AuditAction
  resource    String?
  resourceId  String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@index([action])
  @@index([createdAt])
}
