# Procfile for Render/Heroku deployment
# Deploy API, Admin, and Worker as separate services

# API Service (Fastify)
web: npm run start:api

# Admin Panel Service (Next.js)  
# Deploy as separate service with:
# admin: npm run start:admin

# Worker Service (BullMQ)
# Deploy as separate service with:
# worker: npm run start:worker

# Note: In Railway/Render, deploy each service separately
