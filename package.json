{
  "name": "fotozap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @fotozap/api",
    "dev:admin": "npm run dev -w @fotozap/admin",
    "dev:worker": "npm run worker -w @fotozap/api",
    "build": "npm run db:generate && npm run build --workspaces --if-present",
    "build:api": "npm run build -w @fotozap/api",
    "build:admin": "npm run build -w @fotozap/admin",
    "start": "npm run start -w @fotozap/api",
    "start:api": "npm run start -w @fotozap/api",
    "start:admin": "npm run start -w @fotozap/admin",
    "start:worker": "npm run start:worker -w @fotozap/api",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:production": "tsx prisma/seed.production.ts",
    "db:setup": "npm run db:migrate:deploy && npm run db:seed",
    "db:setup:production": "npm run db:migrate:deploy && npm run db:seed:production",
    "admin:create": "tsx scripts/create-first-admin.ts",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.8",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.23.0",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "ioredis-mock": "^8.13.1",
    "prettier": "^3.6.2",
    "prisma": "7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
