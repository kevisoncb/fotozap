NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3001
ADMIN_PORT=3000

# PostgreSQL (source of truth)
DATABASE_URL=postgresql://fotozap:fotozap@localhost:5432/fotozap?schema=public

# Redis (ephemeral state, locks, queues)
REDIS_URL=redis://localhost:6379

# Conversation
CONVERSATION_TTL_SECONDS=3600

# Limits
MAX_IMAGE_SIZE_MB=10
MAX_GENERATIONS_PER_HOUR=10
MAX_MESSAGES_PER_MINUTE=20
MAX_UPLOADS_PER_HOUR=15
IMAGE_WORKER_CONCURRENCY=5
PAYMENT_EXPIRATION_MINUTES=30
INPUT_RETENTION_HOURS=24
OUTPUT_RETENTION_DAYS=7

# Timezone for display only (storage is UTC)
DISPLAY_TIMEZONE=America/Sao_Paulo
CURRENCY=BRL

# Provider selection: mock | real
WHATSAPP_PROVIDER=mock
PAYMENT_PROVIDER=mock
IMAGE_PROVIDER=mock
STORAGE_PROVIDER=mock

# WhatsApp Cloud API (required when WHATSAPP_PROVIDER=real)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Mercado Pago (required when PAYMENT_PROVIDER=real)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Image provider (required when IMAGE_PROVIDER=real)
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_WEBHOOK_SECRET=

# Cloudflare R2 (required when STORAGE_PROVIDER=real)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=

# Admin auth (hash later; never put a production password here)
ADMIN_SESSION_SECRET=change-me-in-production-min-32-chars
